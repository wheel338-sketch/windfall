{
  "schema": "windfall.preset",
  "version": 1,
  "kind": "plugin",
  "name": "Alternating drawn gate",
  "plugin": {
    "state": {
      "type": "effect",
      "params": {"type": "filterBank", "routing": "serial", "slots": [
        {"mode": "lowpass", "frequencyHz": 3000.0, "q": 0.9}, {}, {}, {}, {}, {}, {}, {}
      ], "patterns": [
        {"enabled": true, "beats": 2.0, "depthOctaves": 1.0, "gate": [1.0, 0.4, 0.8, 0.2, 1.0, 0.4, 0.8, 0.2], "cutoff": [0.0, 0.5, 0.0, -0.5, 0.0, 0.5, 0.0, -0.5]},
        {}, {}, {}, {}, {}, {}, {}
      ]}
    }
  }
}
