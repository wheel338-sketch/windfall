{
  "schema": "windfall.preset",
  "version": 1,
  "kind": "plugin",
  "name": "Two linked filtered echoes",
  "plugin": {
    "state": {
      "type": "effect",
      "params": {"type": "echoBank", "dry": 0.75, "wet": 0.4, "inputGain": 1.0, "feedback": 0.7, "units": [
        {"enabled": true, "sync": false, "timeMs": 95.0, "feedback": 0.25, "outputPan": -0.3, "nextSend": 0.65, "filter": {"mode": "lowpass", "frequencyHz": 4500.0}},
        {"enabled": true, "inputGain": 0.0, "sync": false, "timeMs": 145.0, "feedback": 0.2, "outputPan": 0.3, "filter": {"mode": "highpass", "frequencyHz": 180.0}},
        {"enabled": false}, {"enabled": false}, {"enabled": false}, {"enabled": false}, {"enabled": false}, {"enabled": false}
      ]}
    }
  }
}
